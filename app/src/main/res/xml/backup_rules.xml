<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Academic records and PIN-related preferences are backed up only through RVH Edu's
         explicit Backup & Restore flow, so users can choose where exported files go. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
